{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fit-track-be",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
